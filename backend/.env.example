# ===================== DATABASE =====================
# Local dev (MySQL):
DATABASE_URL=mysql+pymysql://campus_user:campus_pass@localhost:3306/campus_knowledge
# Future deploy (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg://campus_user:campus_pass@localhost:5432/campus_knowledge

# ===================== AUTH =====================
JWT_SECRET_KEY=1e9ee213221e957949c0b0fb08f5b3f41c289b5201fe42d32e0c6c4077f215d2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ===================== PINECONE =====================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=campus-knowledge
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ===================== GEMINI (LLM + EMBEDDINGS) =====================
GEMINI_API_KEY=your-gemini-api-key
# gemini-flash-latest always points to Google's current recommended stable
# Flash model and is hot-swapped automatically as older versions are
# retired - avoids needing to manually chase Gemini's frequent model
# deprecations (e.g. gemini-1.5-flash and text-embedding-004 were both
# fully shut down by Google in early-mid 2026).
LLM_MODEL=gemini-flash-latest
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ===================== FILE STORAGE =====================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# ===================== RAG TUNING =====================
RAG_TOP_K=5
RAG_MIN_SCORE=0.70
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHAT_HISTORY_TURNS=4

# ===================== CORS =====================
FRONTEND_URL=http://localhost:5173

# ===================== APP =====================
ENVIRONMENT=development
LOG_LEVEL=INFO
